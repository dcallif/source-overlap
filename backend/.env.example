# Local LLM (LM Studio exposes an OpenAI-compatible server on port 1234).
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Leave blank to auto-pick the first model the server reports.
LM_STUDIO_MODEL=
LM_TEMPERATURE=0.1
# Read timeout: seconds allowed between streamed tokens before giving up.
LM_TIMEOUT=600
# Qwen3 models emit long "thinking" tokens unless disabled. Off = faster, clean JSON.
LM_DISABLE_THINKING=true
# Seconds to wait for LM Studio when auto-selecting a provider.
LOCAL_PROBE_TIMEOUT=1.5

# Provider selection.
# auto   = connected relay > local LM Studio > public fallback
# local  = LM Studio only
# public = public LLM only
LLM_PROVIDER=auto

# Public fallback. The default is Pollinations' keyless anonymous endpoint.
# Note: question and source text are sent to this third party unless you use
# a local LM Studio or the connector.
PUBLIC_LLM_ENABLED=true
PUBLIC_LLM_URL=https://text.pollinations.ai/openai
PUBLIC_LLM_MODEL=openai-fast
PUBLIC_LLM_LABEL=Pollinations
PUBLIC_LLM_TIMEOUT=120
# Optional bearer token for another OpenAI-compatible provider.
PUBLIC_LLM_API_KEY=

# Hosted mode. Set REQUIRE_CONNECTOR=true to force the connector on a public
# server. Leave false to allow the public LLM fallback.
REQUIRE_CONNECTOR=false
SESSION_TTL_SECONDS=43200
PAIRING_TTL_SECONDS=600
SESSION_COOKIE_NAME=source_overlap_session
# Set true when the app is served over HTTPS (Render sets this in render.yaml).
SESSION_COOKIE_SECURE=false
# Public repository where users install the connector CLI.
PROJECT_URL=https://github.com/dcallif/source-overlap

# Retrieval
MAX_SOURCES=6
FETCH_TIMEOUT=20
# Second keyless news feed. Bing wraps direct publisher links (better full text
# and clearer URLs than Google News' JS redirect links).
ENABLE_BING_NEWS=true
# Maximum number of custom RSS/Atom feeds a user can add (0 disables them).
MAX_CUSTOM_SOURCES=10

# Cache results per question for this many seconds (0 disables).
CACHE_TTL_SECONDS=86400
