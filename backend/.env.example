# Local LLM (LM Studio exposes an OpenAI-compatible server on port 1234).
LM_STUDIO_URL=http://127.0.0.1:1234/v1
# Leave blank to auto-pick the first model the server reports.
LM_STUDIO_MODEL=
LM_TEMPERATURE=0.1
# Read timeout: seconds allowed between streamed tokens before giving up.
LM_TIMEOUT=600
# Qwen3 models emit long "thinking" tokens unless disabled. Off = faster, clean JSON.
LM_DISABLE_THINKING=true

# Hosted mode. Set REQUIRE_CONNECTOR=true on a public server and connect your
# own LM Studio through the connector CLI (see connector/README.md).
REQUIRE_CONNECTOR=false
SESSION_TTL_SECONDS=43200
PAIRING_TTL_SECONDS=600
SESSION_COOKIE_NAME=source_overlap_session
# Set true when the app is served over HTTPS (Render sets this in render.yaml).
SESSION_COOKIE_SECURE=false
# Public repository where users install the connector CLI.
PROJECT_URL=https://github.com/dcallif/source-overlap

# Retrieval
MAX_SOURCES=6
FETCH_TIMEOUT=20
# Second keyless news feed. Bing wraps direct publisher links (better full text
# and clearer URLs than Google News' JS redirect links).
ENABLE_BING_NEWS=true

# Cache results per question for this many seconds (0 disables).
CACHE_TTL_SECONDS=86400
